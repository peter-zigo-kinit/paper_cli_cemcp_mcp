import React from 'react';


];

function ArtifactCard({ artifact }) {
  return (
    <div style={{border: '1px solid gray', padding: '1em', marginBottom: '1em'}}>
      <h2>{artifact.title}</h2>
      <p><em>{artifact.classification}</em></p>
      <img src={artifact.image} alt={artifact.title} style={{maxWidth: '100%', height: 'auto'}} />
      <p>{artifact.intro}</p>
      <ul>
        {artifact.facts.map((fact, idx) => <li key={idx}>{fact}</li>)}
      </ul>
      <p>Icons: {artifact.icons.join(' ')}</p>
      <a href={artifact.url} target="_blank" rel="noopener noreferrer">View on The Met</a>
    </div>
  );
}

export default function ArtifactShowcase() {
  return (
    <div>
      {artifacts.map((artifact, index) => (
        <ArtifactCard key={index} artifact={artifact} />
      ))}
    </div>
  );
}

