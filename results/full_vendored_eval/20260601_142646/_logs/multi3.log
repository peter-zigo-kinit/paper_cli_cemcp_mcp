async def main():
    def extract_result_data(result):
        if not result:
            return None
        if isinstance(result, dict):
            if "data" in result:
                return result["data"]
            return result
        return None

    egyptian_art_ids = []
    sarcophagi_ids = []
    objects_data = []

    # First try broad "Egyptian Art" search
    try:
        search_result = await server_manager.call_tool(
            "MetropolitanMuseum:search_objects",
            {"q": "Egyptian Art", "hasImages": True}
        )
        data = extract_result_data(search_result)
        if data and "objectIDs" in data and data["objectIDs"]:
            egyptian_art_ids = data["objectIDs"][:20]  # get first 20 for filtering
    except Exception:
        egyptian_art_ids = []

    # If fewer than 3 good Egyptian art objects with images, search sarcophagi
    if len(egyptian_art_ids) < 3:
        try:
            sarcophagi_result = await server_manager.call_tool(
                "MetropolitanMuseum:search_objects",
                {"q": "sarcophagus", "hasImages": True}
            )
            data_sarc = extract_result_data(sarcophagi_result)
            if data_sarc and "objectIDs" in data_sarc and data_sarc["objectIDs"]:
                sarcophagi_ids = data_sarc["objectIDs"][:20]
        except Exception:
            sarcophagi_ids = []

    # Combine and prioritize Egyptian Art first, then sarcophagi
    candidate_ids = egyptian_art_ids + sarcophagi_ids

    # Fetch detailed info for candidates until we have 3 with good images and metadata
    for obj_id in candidate_ids:
        if len(objects_data) >= 3:
            break
        try:
            obj_detail_result = await server_manager.call_tool(
                "MetropolitanMuseum:get_object",
                {"objectID": obj_id}
            )
            obj_data = extract_result_data(obj_detail_result)
            if not obj_data:
                continue
            # Check if object has primary image and classification and title
            if (obj_data.get("primaryImage") or obj_data.get("primaryImageSmall")) and obj_data.get("title") and obj_data.get("classification") and obj_data.get("objectName"):
                objects_data.append(obj_data)
        except Exception:
            continue

    # If still fewer than 3, return what we have
    if len(objects_data) < 3:
        reasoned_answer = "I found fewer than 3 Egyptian art objects with good images from the Met's collection metadata, but here are what I could retrieve."
    else:
        reasoned_answer = ""

    # Prepare the 3 objects with requested info
    selected_objects = objects_data[:3]

    # For each object, create intro (~150-200 words) and 5 key facts from available metadata fields
    # Also assign 1-2 icons related to classification or generic ones
    # Collect all info in a structured way

    def generate_intro(obj):
        # Compose a crisp intro using title, classification, period, culture, and medium
        title = obj.get("title", "Untitled")
        classification = obj.get("classification", "Unknown classification")
        culture = obj.get("culture", "Unknown culture")
        period = obj.get("period", "")
        medium = obj.get("medium", "")
        dimensions = obj.get("dimensions", "")

        intro = f"{title} is a notable piece classified as {classification} from the {culture} culture. "
        if period:
            intro += f"Dating to the {period} period, it exemplifies the artistic and cultural achievements of that era. "
        if medium:
            intro += f"Crafted using {medium}, this artifact showcases the techniques and materials favored by artisans of its time. "
        if dimensions:
            intro += f"Its dimensions are approximately {dimensions}. "
        intro += f"This piece holds significant historical importance and is part of the Met's renowned Egyptian Art collection."
        # Keep length roughly 150-200 words (about 900-1200 characters), trim if needed
        if len(intro) > 1200:
            intro = intro[:1197] + "..."
        return intro

    def generate_facts(obj):
        facts = []
        # Use fields like accessionNumber, period, culture, medium, creditLine, repository, objectDate, technique, provenance, etc.
        if obj.get("accessionNumber"):
            facts.append(f"Accession Number: {obj['accessionNumber']}")
        if obj.get("objectDate"):
            facts.append(f"Date: {obj['objectDate']}")
        if obj.get("period"):
            facts.append(f"Period: {obj['period']}")
        if obj.get("culture"):
            facts.append(f"Culture: {obj['culture']}")
        if obj.get("medium"):
            facts.append(f"Medium/Materials: {obj['medium']}")
        if obj.get("creditLine"):
            facts.append(f"Credit Line: {obj['creditLine']}")
        if obj.get("technique"):
            facts.append(f"Technique: {obj['technique']}")
        if obj.get("provenance"):
            facts.append(f"Provenance: {obj['provenance']}")
        if obj.get("dimensions"):
            facts.append(f"Dimensions: {obj['dimensions']}")
        # Limit to 5 facts
        return facts[:5]

    # Assign icons based on classification keywords
    def select_icons(classification):
        icons_map = {
            "Sarcophagus": ["🪦", "⚰️"],
            "Relief": ["🗿", "📜"],
            "Sculpture": ["🗿", "🎨"],
            "Painting": ["🖼️", "🎨"],
            "Amulet": ["📿", "🧿"],
            "Jewelry": ["💍", "📿"],
            "Vessel": ["🏺", "🍶"],
            "Stela": ["🪧", "📜"],
            "Mask": ["🎭", "🗿"],
        }
        # Try to find matching icons
        for key, icons in icons_map.items():
            if key.lower() in classification.lower():
                return icons
        # Default icons
        return ["🏛️", "🖼️"]

    # Build final structured info
    showcase_items = []
    for obj in selected_objects:
        title = obj.get("title", "Untitled")
        classification = obj.get("classification", "Unknown")
        intro = generate_intro(obj)
        facts = generate_facts(obj)
        icons = select_icons(classification)
        primary_image = obj.get("primaryImage") or obj.get("primaryImageSmall") or ""
        # Provide official Met URL for the object
        met_url = obj.get("objectURL", "https://www.metmuseum.org")

        showcase_items.append({
            "title": title,
            "classification": classification,
            "intro": intro,
            "facts": facts,
            "icons": icons,
            "image": primary_image,
            "url": met_url
        })

    # Compose reasoned answer text including the 3 objects info
    reasoned_answer += "Here are three featured Egyptian art objects from the Met's collection with official metadata and images:\n\n"
    for i, item in enumerate(showcase_items, 1):
        reasoned_answer += f"{i}. Title: {item['title']}\n"
        reasoned_answer += f"Classification: {item['classification']}\n"
        reasoned_answer += f"Intro: {item['intro']}\n"
        reasoned_answer += "Key Facts:\n"
        for fact in item['facts']:
            reasoned_answer += f"- {fact}\n"
        reasoned_answer += f"Icons: {' '.join(item['icons'])}\n"
        reasoned_answer += f"Image URL: {item['image']}\n"
        reasoned_answer += f"Met URL: {item['url']}\n\n"

    # Provide React snippet
    react_snippet = '''
import React from 'react';

const artifacts = [
''' + ",\n".join([
    f"  {{\n    title: `{item['title']}`,\n    classification: `{item['classification']}`,\n    intro: `{item['intro'].replace('`', '\\`')}`,\n    facts: {item['facts']},\n    icons: {item['icons']},\n    image: `{item['image']}`,\n    url: `{item['url']}`\n  }}" for item in showcase_items
]) + '''
];

function ArtifactCard({ artifact }) {
  return (
    <div style={{border: '1px solid gray', padding: '1em', marginBottom: '1em'}}>
      <h2>{artifact.title}</h2>
      <p><em>{artifact.classification}</em></p>
      <img src={artifact.image} alt={artifact.title} style={{maxWidth: '100%', height: 'auto'}} />
      <p>{artifact.intro}</p>
      <ul>
        {artifact.facts.map((fact, idx) => <li key={idx}>{fact}</li>)}
      </ul>
      <p>Icons: {artifact.icons.join(' ')}</p>
      <a href={artifact.url} target="_blank" rel="noopener noreferrer">View on The Met</a>
    </div>
  );
}

export default function ArtifactShowcase() {
  return (
    <div>
      {artifacts.map((artifact, index) => (
        <ArtifactCard key={index} artifact={artifact} />
      ))}
    </div>
  );
}
'''

    reasoned_answer += "Here is a React code snippet demonstrating how to feed this data into a component for your digital showcase project:\n\n" + react_snippet

    return (True, reasoned_answer)
